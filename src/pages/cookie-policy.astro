---
// src/pages/cookie-policy.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CookieContent from '../components/legal/CookieContent.astro';

const title = "Kebijakan Kuki (Cookie Policy) - Penggaris Online HP CM";
const description = "Kebijakan kuki Penggaris Online HP CM (penggarisonline.com). Penjelasan penyimpanan lokal, kuki pihak ketiga Google AdSense & DoubleClick, serta panduan pengelolaan browser.";
const canonical = "https://penggarisonline.com/cookie-policy";
const hreflangs = [
  { lang: 'id', url: 'https://penggarisonline.com/cookie-policy' },
  { lang: 'en', url: 'https://penggarisonline.com/en/cookie-policy' },
  { lang: 'x-default', url: 'https://penggarisonline.com/cookie-policy' }
];
---

<Layout title={title} description={description} canonical={canonical} lang="id" hreflangs={hreflangs}>
  <Navbar />
  <main class="flex-1 w-full">
    <CookieContent lang="id" />
  </main>
  <Footer currentLang="id" />
</Layout>
