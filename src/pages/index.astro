  const metricInch = document.getElementById('metric-inch');
  const metricPx = document.getElementById('metric-px');

  // 2D Metrics
  const metric2dW = document.getElementById('metric-2d-w');
  const metric2dH = document.getElementById('metric-2d-h');
  const metric2dArea = document.getElementById('metric-2d-area');
  const metric2dDiag = document.getElementById('metric-2d-diag');

