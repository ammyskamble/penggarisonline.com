    const val = parseFloat(inputManual2dW.value);
    if (isNaN(val) || val <= 0) return;
    const maxLimit = view2dCanvas?.clientWidth || 800;
    rulerEngine.set2DWidthMm(val * 10, maxLimit);
    updateUI();
  };
  inputManual2dW?.addEventListener('change', apply2DWManualInput);
  inputManual2dW?.addEventListener('input', apply2DWManualInput);
  inputManual2dW?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') apply2DWManualInput();
  });

  const apply2DHManualInput = () => {
    if (!inputManual2dH) return;
    const val = parseFloat(inputManual2dH.value);
    if (isNaN(val) || val <= 0) return;
    const maxLimit = view2dCanvas?.clientHeight || 600;
    rulerEngine.set2DHeightMm(val * 10, maxLimit);
    updateUI();
  };
  inputManual2dH?.addEventListener('change', apply2DHManualInput);
  inputManual2dH?.addEventListener('input', apply2DHManualInput);
  inputManual2dH?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') apply2DHManualInput();
  });

  // Circle Mode Steppers & Manual Input
  btnStepCircle.forEach(btn => {
    btn.addEventListener('click', () => {
      const stepMm = parseFloat(btn.getAttribute('data-step') || '0');
      rulerEngine.stepCircleDiameterMm(stepMm);
      updateUI();
    });
  });

  const applyCircleManualInput = () => {
    if (!inputManualCircle) return;
    const val = parseFloat(inputManualCircle.value);
    if (isNaN(val) || val <= 0) return;
    rulerEngine.setCircleDiameterMm(val);
    updateUI();
  };
  inputManualCircle?.addEventListener('change', applyCircleManualInput);
  inputManualCircle?.addEventListener('input', applyCircleManualInput);
  inputManualCircle?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') applyCircleManualInput();
  });

  // Angle Mode Steppers & Manual Input
  btnStepAngle.forEach(btn => {
    btn.addEventListener('click', () => {
      const stepDeg = parseFloat(btn.getAttribute('data-step') || '0');
      rulerEngine.stepAngleDegrees(stepDeg);
      updateUI();
    });
  });

  const applyAngleManualInput = () => {
    if (!inputManualAngle) return;
    const val = parseFloat(inputManualAngle.value);
    if (isNaN(val)) return;
    rulerEngine.setAngleDegrees(val);
    updateUI();
  };
  inputManualAngle?.addEventListener('change', applyAngleManualInput);
  inputManualAngle?.addEventListener('input', applyAngleManualInput);
  inputManualAngle?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') applyAngleManualInput();
  });

  btnQuickAnglePills.forEach(btn => {
    btn.addEventListener('click', () => {
      const deg = parseFloat(btn.getAttribute('data-angle') || '45');
      rulerEngine.setAngleDegrees(deg);
      updateUI();
    });
  });

  // Copy measurement
  btnCopyMeasurement?.addEventListener('click', async () => {
    let textToCopy = '';
    if (rulerEngine.activeTool === '1d') {
      const live = rulerEngine.getLiveMeasurement();
      textToCopy = `${live.formattedPrimary} (${live.mm} mm, ${live.inch} in)`;
    } else if (rulerEngine.activeTool === '2d') {
      const m2d = rulerEngine.get2DMeasurements();
      textToCopy = `Dimensi: ${m2d.widthCm} x ${m2d.heightCm} cm (Luas: ${m2d.areaCm2} cm², Diagonal: ${m2d.diagCm} cm)`;
    } else if (rulerEngine.activeTool === 'circle') {
      const circ = rulerEngine.getCircleMeasurements();
      textToCopy = `Diameter Lingkaran: ${circ.diameterCm} cm (${circ.diameterMm} mm), Keliling: ${circ.circumferenceCm} cm, Luas: ${circ.areaCm2} cm²`;
    } else {
      const ang = rulerEngine.getAngleMeasurements();
      textToCopy = `Sudut: ${ang.degrees}° (${ang.classification}, ${ang.radians} rad)`;
    }

    try {
      await navigator.clipboard.writeText(textToCopy);
      if (copyIconDefault && copyIconCheck && copyBtnText) {
        copyIconDefault.classList.add('hidden');
        copyIconCheck.classList.remove('hidden');
        copyBtnText.textContent = 'Tersalin!';
        setTimeout(() => {
          copyIconDefault.classList.remove('hidden');
          copyIconCheck.classList.add('hidden');
          copyBtnText.textContent = 'Salin Ukuran';
        }, 2000);
      }
    } catch (_) {
      prompt('Salin hasil pengukuran:', textToCopy);
    }
  });

  // Preset Selector
  devicePresetSelect?.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement;
    const val = target.value;
    if (val === 'auto') {
      rulerEngine.resetCalibration();
    } else {
      const ppi = parseFloat(val);
      if (!isNaN(ppi)) {
        const optionLabel = target.options[target.selectedIndex]?.text || '';
        rulerEngine.setPpi(ppi, optionLabel.split('(')[0].trim());
      }
    }
  });

  // Modal Open/Close
  function openModal() {
    tempPpi = rulerEngine.ppi;
    updateModalCardVisual(tempPpi);
    calibrationModal?.classList.remove('hidden');
    calibrationModal?.classList.add('flex');
  }

  function closeModal() {
    calibrationModal?.classList.add('hidden');
    calibrationModal?.classList.remove('flex');
  }

  btnOpenCalib?.addEventListener('click', openModal);
  btnQuickCalib?.addEventListener('click', openModal);
  btnCloseModal?.addEventListener('click', closeModal);
  btnCancelCalib?.addEventListener('click', closeModal);

  // Tab switching in modal
  calibTabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab-target');
      calibTabButtons.forEach(b => {
        b.className = 'calib-tab-btn flex-1 py-2 text-xs sm:text-sm font-medium text-(--muted-foreground) hover:text-(--foreground) rounded-lg transition-all';
      });
      btn.className = 'calib-tab-btn flex-1 py-2 text-xs sm:text-sm font-semibold rounded-lg bg-(--card) text-(--foreground) shadow-xs transition-all';

      calibTabContents.forEach(c => {
        if (c.id === targetId) c.classList.remove('hidden');
        else c.classList.add('hidden');
      });
    });
  });

  function updateModalCardVisual(ppi: number) {
    const cardPxWidth = Math.round(ppi * CARD_STANDARD.widthInch);
    const cardPxHeight = Math.round(ppi * CARD_STANDARD.heightInch);

    if (visualCalibCard) {
      visualCalibCard.style.width = `${cardPxWidth}px`;
      visualCalibCard.style.height = `${cardPxHeight}px`;
    }
    if (cardWidthSlider) cardWidthSlider.value = cardPxWidth.toString();
    if (cardSliderValLabel) cardSliderValLabel.textContent = `${cardPxWidth} px (${ppi.toFixed(1)} PPI)`;
    if (calibCardWidthPx) calibCardWidthPx.textContent = `${cardPxWidth} px`;
    if (inputManualPpi) inputManualPpi.value = ppi.toFixed(1);
  }

  cardWidthSlider?.addEventListener('input', (e) => {
    const widthPx = parseFloat((e.target as HTMLInputElement).value);
    tempPpi = widthPx / CARD_STANDARD.widthInch;
    updateModalCardVisual(tempPpi);
  });

  btnApplyDiagonal?.addEventListener('click', () => {
    if (!inputDiagonalInches) return;
    const diag = parseFloat(inputDiagonalInches.value);
    if (!isNaN(diag) && diag > 2 && diag < 85) {
      const w = window.screen.width;
      const h = window.screen.height;
      tempPpi = Math.sqrt(w * w + h * h) / diag;
      updateModalCardVisual(tempPpi);
      saveCalibration(`Diagonal ${diag}"`);
    }
  });

  quickDiagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const diagStr = btn.getAttribute('data-diag');
      if (diagStr && inputDiagonalInches) {
        inputDiagonalInches.value = diagStr;
        const diag = parseFloat(diagStr);
        const w = window.screen.width;
        const h = window.screen.height;
        tempPpi = Math.sqrt(w * w + h * h) / diag;
        updateModalCardVisual(tempPpi);
      }
    });
  });

  btnPpiMinus1?.addEventListener('click', () => { tempPpi = Math.max(30, tempPpi - 1); updateModalCardVisual(tempPpi); });
  btnPpiMinus01?.addEventListener('click', () => { tempPpi = Math.max(30, tempPpi - 0.1); updateModalCardVisual(tempPpi); });
  btnPpiPlus01?.addEventListener('click', () => { tempPpi = Math.min(900, tempPpi + 0.1); updateModalCardVisual(tempPpi); });
  btnPpiPlus1?.addEventListener('click', () => { tempPpi = Math.min(900, tempPpi + 1); updateModalCardVisual(tempPpi); });
  inputManualPpi?.addEventListener('input', (e) => {
    const val = parseFloat((e.target as HTMLInputElement).value);
    if (!isNaN(val) && val >= 30 && val <= 900) {
      tempPpi = val;
      updateModalCardVisual(tempPpi);
    }
  });

  function saveCalibration(method = 'e-KTP / Kartu ATM') {
    rulerEngine.setPpi(tempPpi, method);
    closeModal();
  }

  btnSaveCalib?.addEventListener('click', () => saveCalibration('e-KTP / Kartu ATM'));
  btnResetCalibDefault?.addEventListener('click', () => {
    rulerEngine.resetCalibration();
    closeModal();
  });

  // Listen to engine updates
  rulerEngine.subscribe(() => {
    renderRulerTicks();
    render2DRulerTicks();
    renderCircleGrid();
    renderProtractor();
    updateUI();
  });

  // Orientation toggle
  btnToggleOrientation?.addEventListener('click', () => {
    const nextOrient = rulerEngine.orientation === 'horizontal' ? 'vertical' : 'horizontal';
    rulerEngine.setOrientation(nextOrient);
    if (view1dCanvas) {
      if (nextOrient === 'vertical') {
        view1dCanvas.classList.remove('h-56', 'sm:h-64');
        view1dCanvas.classList.add('h-[480px]', 'sm:h-[540px]');
      } else {
        view1dCanvas.classList.add('h-56', 'sm:h-64');
        view1dCanvas.classList.remove('h-[480px]', 'sm:h-[540px]');
      }
    }
  });

  // Dual-scale toggle (cm + inch simultaneously on 1D ruler)
  const btnToggleDualScale = document.getElementById('btn-toggle-dual-scale');
  btnToggleDualScale?.addEventListener('click', () => {
    const nextMode = rulerEngine.scaleMode === 'dual' ? 'single' : 'dual';
    rulerEngine.setScaleMode(nextMode);
    if (nextMode === 'dual') {
      btnToggleDualScale.classList.add('bg-indigo-500', 'text-white', 'border-indigo-500');
    } else {
      btnToggleDualScale.classList.remove('bg-indigo-500', 'text-white', 'border-indigo-500');
    }
    renderRulerTicks();
    updateUI();
  });


  const btnToggleEdgeMode = document.getElementById('btn-toggle-edge-mode');
  const btnCloseEdgeMode = document.getElementById('btn-close-edge-mode');
  const edgeRulersOverlay = document.getElementById('edge-rulers-overlay');
  const edgeToggleButtons = document.querySelectorAll<HTMLButtonElement>('.edge-toggle-btn');

  const edgeRulerTop = document.getElementById('edge-ruler-top') as SVGSVGElement | null;
  const edgeRulerBottom = document.getElementById('edge-ruler-bottom') as SVGSVGElement | null;
  const edgeRulerLeft = document.getElementById('edge-ruler-left') as SVGSVGElement | null;
  const edgeRulerRight = document.getElementById('edge-ruler-right') as SVGSVGElement | null;

  const edgeBgTop = document.getElementById('edge-bg-top');
  const edgeBgBottom = document.getElementById('edge-bg-bottom');
  const edgeBgLeft = document.getElementById('edge-bg-left');
  const edgeBgRight = document.getElementById('edge-bg-right');

  const edgeTicksTop = document.getElementById('edge-ticks-top');
  const edgeTicksBottom = document.getElementById('edge-ticks-bottom');
  const edgeTicksLeft = document.getElementById('edge-ticks-left');
  const edgeTicksRight = document.getElementById('edge-ticks-right');

  const edgeSurface = document.getElementById('edge-surface');
  const edgeGuidesGroup = document.getElementById('edge-guides-group');
  const edgeCrosshairH = document.getElementById('edge-crosshair-h');
  const edgeCrosshairV = document.getElementById('edge-crosshair-v');
  const edgeCursorReadout = document.getElementById('edge-cursor-readout');
  const btnEdgeCrosshair = document.getElementById('btn-edge-crosshair');
  const btnEdgeClearGuides = document.getElementById('btn-edge-clear-guides');
  const edgeWelcomeHint = document.getElementById('edge-welcome-hint');

  const activeEdges = {
    top: true,
    bottom: false,
    left: true,
    right: false
  };
  let crosshairActive = false;

  let edgeUnit: 'cm' | 'inch' = 'cm';
  let edgeFlipX = false;
  let edgeFlipY = false;

  const edgeUnitButtons = document.querySelectorAll<HTMLButtonElement>('.edge-unit-btn');
  const btnEdgeFlipX = document.getElementById('btn-edge-flip-x');
  const btnEdgeFlipY = document.getElementById('btn-edge-flip-y');
  const edgeHudDimensions = document.getElementById('edge-hud-dimensions');
  const edgeHudPixels = document.getElementById('edge-hud-pixels');

  function renderEdgeRulers() {
    if (!edgeRulersOverlay || edgeRulersOverlay.classList.contains('hidden')) return;

    const w = window.innerWidth;
    const h = window.innerHeight;
    const ppi = rulerEngine.ppi;
    const pxPerMm = ppi / 25.4;
    const textFill = 'var(--foreground)';

    // Update edge elements & background tracks visibility
    if (edgeRulerTop) edgeRulerTop.style.display = activeEdges.top ? 'block' : 'none';
    if (edgeBgTop) edgeBgTop.style.display = activeEdges.top ? 'block' : 'none';
    if (edgeRulerBottom) edgeRulerBottom.style.display = activeEdges.bottom ? 'block' : 'none';
    if (edgeBgBottom) edgeBgBottom.style.display = activeEdges.bottom ? 'block' : 'none';
    if (edgeRulerLeft) edgeRulerLeft.style.display = activeEdges.left ? 'block' : 'none';
    if (edgeBgLeft) edgeBgLeft.style.display = activeEdges.left ? 'block' : 'none';
    if (edgeRulerRight) edgeRulerRight.style.display = activeEdges.right ? 'block' : 'none';
    if (edgeBgRight) edgeBgRight.style.display = activeEdges.right ? 'block' : 'none';

    // Hide welcome hint if any edge is active
    const hasAnyEdge = activeEdges.top || activeEdges.bottom || activeEdges.left || activeEdges.right;
    if (edgeWelcomeHint) edgeWelcomeHint.style.display = hasAnyEdge ? 'none' : 'flex';

    // Update button active styles
    edgeToggleButtons.forEach(btn => {
