      edgeCrosshairV?.classList.add('hidden');
      edgeCursorReadout?.classList.add('hidden');
    }
  });

  // Surface pointer tracking & guide lines
  edgeSurface?.addEventListener('pointermove', (e) => {
    if (!crosshairActive) return;
    const x = e.clientX;
    const y = e.clientY;

    if (edgeCrosshairH) edgeCrosshairH.style.top = `${y}px`;
    if (edgeCrosshairV) edgeCrosshairV.style.left = `${x}px`;

    if (edgeCursorReadout) {
      edgeCursorReadout.style.left = `${x}px`;
      edgeCursorReadout.style.top = `${y}px`;
      const xCm = (x / rulerEngine.ppi * 2.54).toFixed(2);
      const yCm = (y / rulerEngine.ppi * 2.54).toFixed(2);
      edgeCursorReadout.textContent = `X: ${xCm} cm | Y: ${yCm} cm`;
    }
  });

  // Add guide line on surface click
  edgeSurface?.addEventListener('click', (e) => {
    if (!edgeGuidesGroup || (e.target as HTMLElement).closest('#btn-close-edge-mode') || (e.target as HTMLElement).closest('.glass-panel')) return;
    const x = e.clientX;
    const y = e.clientY;

    // Drop horizontal guide line
    const hLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    hLine.setAttribute('x1', '0');
    hLine.setAttribute('y1', y.toString());
    hLine.setAttribute('x2', window.innerWidth.toString());
    hLine.setAttribute('y2', y.toString());
    hLine.setAttribute('stroke', '#38bdf8');
    hLine.setAttribute('stroke-width', '1.5');
    hLine.setAttribute('stroke-dasharray', '4 4');
    edgeGuidesGroup.appendChild(hLine);

    // Drop vertical guide line
    const vLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    vLine.setAttribute('x1', x.toString());
    vLine.setAttribute('y1', '0');
    vLine.setAttribute('x2', x.toString());
    vLine.setAttribute('y2', window.innerHeight.toString());
    vLine.setAttribute('stroke', '#38bdf8');
    vLine.setAttribute('stroke-width', '1.5');
    vLine.setAttribute('stroke-dasharray', '4 4');
    edgeGuidesGroup.appendChild(vLine);
  });

  // Clear guides
  btnEdgeClearGuides?.addEventListener('click', () => {
    if (edgeGuidesGroup) edgeGuidesGroup.innerHTML = '';
  });

  // Window resize & keyboard Escape
  window.addEventListener('resize', () => {
    renderEdgeRulers();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (edgeRulersOverlay && !edgeRulersOverlay.classList.contains('hidden')) {
        closeEdgeMode();
      }
    }
  });

  // --- SETUP DRAG & INTERACTION HANDLERS ---
  setup1DDrag(caliperPointerA, true);
  setup1DDrag(caliperPointerB, false);
  setup2DHandlers();
  setupCircleHandlers();
  setupAngleHandlers();

  // Initial draw & tool select
  switchTool(rulerEngine.activeTool || '1d');
  updateUI();
</script>
