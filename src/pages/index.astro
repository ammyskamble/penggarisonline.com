  function openEdgeMode() {
    if (edgeRulersOverlay) {
      edgeRulersOverlay.classList.remove('hidden');
      edgeRulersOverlay.classList.add('flex');
      renderEdgeRulers();
    }
  }

  function closeEdgeMode() {
    if (edgeRulersOverlay) {
      edgeRulersOverlay.classList.add('hidden');
      edgeRulersOverlay.classList.remove('flex');
    }
  }

  btnToggleEdgeMode?.addEventListener('click', openEdgeMode);
  btnCloseEdgeMode?.addEventListener('click', closeEdgeMode);

  // Toggle individual edges (Top, Bottom, Left, Right)
  edgeToggleButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const edge = btn.getAttribute('data-edge-btn') as 'top' | 'bottom' | 'left' | 'right';
      if (edge) {
        activeEdges[edge] = !activeEdges[edge];
        renderEdgeRulers();
      }
    });
  });

  // Edge Unit Selector (cm vs inch)
  edgeUnitButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const u = btn.getAttribute('data-edge-unit') as 'cm' | 'inch';
      if (u && u !== edgeUnit) {
        edgeUnit = u;
        renderEdgeRulers();
      }
    });
  });

  // Directional Flip X (Horizontal)
  btnEdgeFlipX?.addEventListener('click', () => {
    edgeFlipX = !edgeFlipX;
    renderEdgeRulers();
  });

  // Directional Flip Y (Vertical)
  btnEdgeFlipY?.addEventListener('click', () => {
    edgeFlipY = !edgeFlipY;
    renderEdgeRulers();
  });

  // Crosshair toggle
  btnEdgeCrosshair?.addEventListener('click', () => {
    crosshairActive = !crosshairActive;
    if (crosshairActive) {
      btnEdgeCrosshair.classList.add('bg-indigo-500', 'text-white', 'border-indigo-500');
      edgeCrosshairH?.classList.remove('hidden');
      edgeCrosshairV?.classList.remove('hidden');
      edgeCursorReadout?.classList.remove('hidden');
    } else {
      btnEdgeCrosshair.classList.remove('bg-indigo-500', 'text-white', 'border-indigo-500');
