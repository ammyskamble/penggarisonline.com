---
// index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import DevicePresetBar from '../components/DevicePresetBar.astro';
import RulerCanvas from '../components/RulerCanvas.astro';
import MeasurementCard from '../components/MeasurementCard.astro';
import CalibrationModal from '../components/CalibrationModal.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import CalibrationGuide from '../components/CalibrationGuide.astro';
import ConversionTable from '../components/ConversionTable.astro';
import SeoContentSection from '../components/SeoContentSection.astro';
import CompetitorComparison from '../components/CompetitorComparison.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import ScreenEdgeRulers from '../components/ScreenEdgeRulers.astro';
---

<Layout>
  <Navbar />
  <DevicePresetBar />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    <!-- Hero Title & Subheading -->
    <div class="text-center max-w-3xl mx-auto pt-2 pb-1">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-(--foreground) tracking-tight">
        Penggaris <span class="bg-gradient-to-r from-indigo-500 via-indigo-600 to-cyan-500 bg-clip-text text-transparent">Online HP CM</span> Ukuran Asli
      </h1>
      <p class="mt-2 text-sm sm:text-base text-(--muted-foreground)">
        Alat ukur mistar digital akurat 1:1 di layar HP, telepon, tablet, dan laptop. Penggaris sesuai skala dengan kalibrasi e-KTP/ATM, penggaris 2D luas bidang, pengukur lingkaran, dan mode tepi layar.
      </p>
    </div>

    <!-- Interactive Canvas & Tools -->
    <RulerCanvas />

    <!-- Live Real-Time Measurement Card -->
    <MeasurementCard />

    <!-- Features Section -->
    <FeaturesSection />

    <!-- Step-by-Step Calibration Guide -->
    <CalibrationGuide />

    <!-- Conversion Calculator & Table -->
    <ConversionTable />

    <!-- Comprehensive SEO Guide (800-1200 words) -->
    <SeoContentSection />

    <!-- Competitor Comparison Table -->
    <CompetitorComparison />

    <!-- FAQ Section -->
    <FAQSection />
  </main>

  <CalibrationModal />
  <ScreenEdgeRulers />
  <Footer />
</Layout>

<script>
  import { rulerEngine, CARD_STANDARD } from '../scripts/ruler-engine.js';

  // Initialize engine (loads saved PPI, unit, orientation from localStorage + auto-detects PPI)
  rulerEngine.init();

  // --- 1. DOM REFERENCES ---
  // Tool Viewports
  const toolButtons = document.querySelectorAll<HTMLButtonElement>('[data-tool-btn]');
  const view1dCanvas = document.getElementById('view-1d-canvas');
  const view2dCanvas = document.getElementById('view-2d-canvas');
  const viewCircleCanvas = document.getElementById('view-circle-canvas');
  const viewAngleCanvas = document.getElementById('view-angle-canvas');

  // Lock Button & Banner
  const btnToggleLock = document.getElementById('btn-toggle-lock');
  const lockIconUnlocked = document.getElementById('lock-icon-unlocked');
  const lockIconLocked = document.getElementById('lock-icon-locked');
  const lockBtnText = document.getElementById('lock-btn-text');
  const lockedStatusBanner = document.getElementById('locked-status-banner');
  const btnUnlockBanner = document.getElementById('btn-unlock-banner');

  // 1D Ruler Viewport
  const rulerSvg = document.getElementById('ruler-svg') as SVGSVGElement | null;
  const metricTicksGroup = document.getElementById('metric-ticks-group');
  const imperialTicksGroup = document.getElementById('imperial-ticks-group');
  const caliperPointerA = document.getElementById('caliper-pointer-a');
  const caliperPointerB = document.getElementById('caliper-pointer-b');
  const caliperHighlightArea = document.getElementById('caliper-highlight-area');
  const rulerFloatDimension = document.getElementById('ruler-float-dimension');

  // 2D Canvas Elements
  const ruler2dSvg = document.getElementById('ruler-2d-svg') as SVGSVGElement | null;
  const ticks2dX = document.getElementById('ticks-2d-x');
  const ticks2dY = document.getElementById('ticks-2d-y');
  const caliperBox2d = document.getElementById('caliper-box-2d');
  const handle2dCorner = document.getElementById('handle-2d-corner');
  const handle2dDrag = document.getElementById('handle-2d-drag');
  const badge2dDimensions = document.getElementById('badge-2d-dimensions');
  const badge2dArea = document.getElementById('badge-2d-area');

  // Circle Canvas Elements
  const circleSvg = document.getElementById('circle-svg') as SVGSVGElement | null;
  const circleBackgroundGrid = document.getElementById('circle-background-grid');
  const dynamicCaliperCircle = document.getElementById('dynamic-caliper-circle');
  const circleDiameterLine = document.getElementById('circle-diameter-line');
  const circleCenterBadge = document.getElementById('circle-center-badge');
  const circleBadgeDiameter = document.getElementById('circle-badge-diameter');
  const circleBadgeSub = document.getElementById('circle-badge-sub');
  const handleCircleRadius = document.getElementById('handle-circle-radius');
  const sliderCircleDiameter = document.getElementById('slider-circle-diameter') as HTMLInputElement | null;
  const circleSliderLabel = document.getElementById('circle-slider-label');
  const coinPresetButtons = document.querySelectorAll<HTMLButtonElement>('.btn-coin-preset');
  const crosshairX = document.getElementById('crosshair-x');
  const crosshairY = document.getElementById('crosshair-y');

  // Angle / Protractor Elements
  const protractorSvg = document.getElementById('protractor-svg') as SVGSVGElement | null;
  const protractorMarkings = document.getElementById('protractor-markings');
  const angleArcPath = document.getElementById('angle-arc-path');
  const angleArm1Line = document.getElementById('angle-arm1-line');
  const angleArm2Line = document.getElementById('angle-arm2-line');
  const protractorPivot = document.getElementById('protractor-pivot');
  const handleAngleArm1 = document.getElementById('handle-angle-arm1');
  const handleAngleArm2 = document.getElementById('handle-angle-arm2');
  const angleDegreesReadout = document.getElementById('angle-degrees-readout');
  const angleSubReadout = document.getElementById('angle-sub-readout');

  // Measurement Card Metric Groups
  const metricsGroup1d = document.getElementById('metrics-group-1d');
  const metricsGroup2d = document.getElementById('metrics-group-2d');
  const metricsGroupCircle = document.getElementById('metrics-group-circle');
  const metricsGroupAngle = document.getElementById('metrics-group-angle');

  // Measurement Card Readouts
  const readoutTitleText = document.getElementById('readout-title-text');
  const readoutSubtitleText = document.getElementById('readout-subtitle-text');
  const readoutPrimaryValue = document.getElementById('readout-primary-value');
  const readoutPrimaryUnit = document.getElementById('readout-primary-unit');
  const readoutFractionBadge = document.getElementById('readout-fraction-badge');
  const readoutPulseDot = document.getElementById('readout-pulse-dot');
  const stepperControls = document.getElementById('stepper-controls');

  // 1D Metrics
  const metricCm = document.getElementById('metric-cm');
