---
// src/pages/privacy-policy.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PrivacyContent from '../components/legal/PrivacyContent.astro';

const title = "Kebijakan Privasi - Penggaris Online HP CM";
const description = "Kebijakan privasi Penggaris Online HP CM (penggarisonline.com). Penjelasan penyimpanan kalibrasi lokal, privasi 100% aman tanpa pelacakan kamera.";
const canonical = "https://penggarisonline.com/privacy-policy";
const hreflangs = [
  { lang: 'id', url: 'https://penggarisonline.com/privacy-policy' },
  { lang: 'en', url: 'https://penggarisonline.com/en/privacy-policy' },
  { lang: 'x-default', url: 'https://penggarisonline.com/privacy-policy' }
];
---

<Layout title={title} description={description} canonical={canonical} lang="id" hreflangs={hreflangs}>
  <Navbar />
  <main class="flex-1 w-full">
    <PrivacyContent lang="id" />
  </main>
  <Footer currentLang="id" />
</Layout>
