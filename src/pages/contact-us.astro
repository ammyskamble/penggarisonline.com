---
// src/pages/contact-us.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactContent from '../components/legal/ContactContent.astro';

const title = "Hubungi Kami - Penggaris Online HP CM";
const description = "Hubungi tim Penggaris Online HP CM (penggarisonline.com) untuk pertanyaan kalibrasi, laporan bug, saran fitur baru, atau kemitraan.";
const canonical = "https://penggarisonline.com/contact-us";
const hreflangs = [
  { lang: 'id', url: 'https://penggarisonline.com/contact-us' },
  { lang: 'en', url: 'https://penggarisonline.com/en/contact-us' },
  { lang: 'x-default', url: 'https://penggarisonline.com/contact-us' }
];
---

<Layout title={title} description={description} canonical={canonical} lang="id" hreflangs={hreflangs}>
  <Navbar />
  <main class="flex-1 w-full">
    <ContactContent lang="id" />
  </main>
  <Footer currentLang="id" />
</Layout>
