---
// src/pages/terms-conditions.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TermsContent from '../components/legal/TermsContent.astro';

const title = "Syarat & Ketentuan - Penggaris Online HP CM";
const description = "Syarat dan ketentuan penggunaan situs web Penggaris Online HP CM (penggarisonline.com). Ketentuan lisensi bebas biaya, batasan tanggung jawab, dan hak cipta.";
const canonical = "https://penggarisonline.com/terms-conditions";
const hreflangs = [
  { lang: 'id', url: 'https://penggarisonline.com/terms-conditions' },
  { lang: 'en', url: 'https://penggarisonline.com/en/terms-conditions' },
  { lang: 'x-default', url: 'https://penggarisonline.com/terms-conditions' }
];
---

<Layout title={title} description={description} canonical={canonical} lang="id" hreflangs={hreflangs}>
  <Navbar />
  <main class="flex-1 w-full">
    <TermsContent lang="id" />
  </main>
  <Footer currentLang="id" />
</Layout>
