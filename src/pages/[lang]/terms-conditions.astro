---
// src/pages/[lang]/terms-conditions.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import TermsContent from '../../components/legal/TermsContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const isId = lang === 'id';

const title = isId
  ? "Syarat & Ketentuan - Penggaris Online HP CM"
  : "Terms & Conditions - Precision Online Ruler";

const description = isId
  ? "Syarat dan ketentuan penggunaan situs web Penggaris Online HP CM (penggarisonline.com). Ketentuan lisensi bebas biaya, batasan tanggung jawab, dan hak cipta."
  : "Terms and conditions of service for Penggaris Online (penggarisonline.com). Free usage terms, accuracy disclaimer, and rights.";

const canonical = `https://penggarisonline.com/${lang}/terms-conditions`;
const hreflangs = [
  { lang: 'id', url: 'https://penggarisonline.com/id/terms-conditions' },
  { lang: 'en', url: 'https://penggarisonline.com/en/terms-conditions' },
  { lang: 'x-default', url: 'https://penggarisonline.com/terms-conditions' }
];
---

<Layout title={title} description={description} canonical={canonical} lang={lang} hreflangs={hreflangs}>
  <Navbar />
  <main class="flex-1 w-full">
    <TermsContent lang={lang} />
  </main>
  <Footer currentLang={lang} />
</Layout>
