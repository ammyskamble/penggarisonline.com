---
// src/pages/[lang]/privacy-policy.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PrivacyContent from '../../components/legal/PrivacyContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const isId = lang === 'id';

const title = isId
  ? "Kebijakan Privasi - Penggaris Online HP CM"
  : "Privacy Policy - Precision Online Ruler";

const description = isId
  ? "Kebijakan privasi Penggaris Online HP CM (penggarisonline.com). Penjelasan penyimpanan kalibrasi lokal, privasi 100% aman tanpa pelacakan kamera."
  : "Privacy policy for Penggaris Online (penggarisonline.com). Local storage transparency, zero camera tracking, and client-side measurement.";

const canonical = `https://penggarisonline.com/${lang}/privacy-policy`;
const hreflangs = [
  { lang: 'id', url: 'https://penggarisonline.com/id/privacy-policy' },
  { lang: 'en', url: 'https://penggarisonline.com/en/privacy-policy' },
  { lang: 'x-default', url: 'https://penggarisonline.com/privacy-policy' }
];
---

<Layout title={title} description={description} canonical={canonical} lang={lang} hreflangs={hreflangs}>
  <Navbar />
  <main class="flex-1 w-full">
    <PrivacyContent lang={lang} />
  </main>
  <Footer currentLang={lang} />
</Layout>
