---
// src/pages/[lang]/about-us.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import AboutContent from '../../components/legal/AboutContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const isId = lang === 'id';

const title = isId
  ? "Tentang Kami - Penggaris Online HP CM"
  : "About Us - Precision Online Ruler";

const description = isId
  ? "Tentang Penggaris Online HP CM (penggarisonline.com). Pelajari misi kami menghadirkan mistar digital ukuran asli 1:1 akurat berstandar ISO di Indonesia."
  : "About Penggaris Online (penggarisonline.com). Discover our mission to deliver sub-millimeter 1:1 scale measurement tools.";

const canonical = `https://penggarisonline.com/${lang}/about-us`;
const hreflangs = [
  { lang: 'id', url: 'https://penggarisonline.com/id/about-us' },
  { lang: 'en', url: 'https://penggarisonline.com/en/about-us' },
  { lang: 'x-default', url: 'https://penggarisonline.com/about-us' }
];
---

<Layout title={title} description={description} canonical={canonical} lang={lang} hreflangs={hreflangs}>
  <Navbar />
  <main class="flex-1 w-full">
    <AboutContent lang={lang} />
  </main>
  <Footer currentLang={lang} />
</Layout>
