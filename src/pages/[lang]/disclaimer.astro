---
// src/pages/[lang]/disclaimer.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import DisclaimerContent from '../../components/legal/DisclaimerContent.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const isId = lang === 'id';

const title = isId
  ? "Penafian (Disclaimer) - Penggaris Online HP CM"
  : "Disclaimer - Precision Online Ruler";

const description = isId
  ? "Penafian resmi Penggaris Online HP CM (penggarisonline.com). Batasan akurasi mistar digital, toleransi kalibrasi layar, dan pemisahan materi iklan Google AdSense."
  : "Official disclaimer for Penggaris Online HP CM (penggarisonline.com). Measurement tolerances, educational utility, and Google AdSense advertisement separation disclosures.";

const canonical = `https://penggarisonline.com/${lang}/disclaimer`;
const hreflangs = [
  { lang: 'id', url: 'https://penggarisonline.com/id/disclaimer' },
  { lang: 'en', url: 'https://penggarisonline.com/en/disclaimer' },
  { lang: 'x-default', url: 'https://penggarisonline.com/disclaimer' }
];
---

<Layout title={title} description={description} canonical={canonical} lang={lang} hreflangs={hreflangs}>
  <Navbar />
  <main class="flex-1 w-full">
    <DisclaimerContent lang={lang} />
  </main>
  <Footer currentLang={lang} />
</Layout>
