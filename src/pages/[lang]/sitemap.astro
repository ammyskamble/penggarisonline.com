---
// src/pages/[lang]/sitemap.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params;
const isId = lang === 'id';

const title = isId
  ? "Peta Situs (Sitemap) - Penggaris Online HP CM"
  : "HTML Sitemap - Precision Online Ruler";

const description = isId
  ? "Peta situs lengkap Penggaris Online HP CM (penggarisonline.com). Indeks navigasi seluruh alat ukur, kalibrasi, panduan FAQ, dan dokumen legalitas."
  : "Full HTML sitemap for Penggaris Online (penggarisonline.com). Complete index of on-screen measurement tools, calibrations, FAQ guides, and legal policies.";

const canonical = `https://penggarisonline.pages.dev/${lang}/sitemap`;
const hreflangs = [
  { lang: 'id', url: 'https://penggarisonline.pages.dev/id/sitemap' },
  { lang: 'en', url: 'https://penggarisonline.pages.dev/en/sitemap' },
  { lang: 'x-default', url: 'https://penggarisonline.pages.dev/sitemap' }
];
---

<Layout title={title} description={description} canonical={canonical} lang={lang} hreflangs={hreflangs}>
  <Navbar />
  
  <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10 w-full">
    <!-- Header -->
    <div class="space-y-3 text-center sm:text-left border-b border-(--border) pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-cyan-400 text-xs font-bold uppercase tracking-wider border border-indigo-500/20">
        <span>🗺️</span>
        <span>{isId ? 'Indeks Navigasi & SEO Google Search Console' : 'Navigation Directory & Search Console Index'}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-(--foreground) tracking-tight">
        {isId ? 'Peta Situs (HTML Sitemap)' : 'HTML Sitemap Directory'}
      </h1>
      <p class="text-sm text-(--muted-foreground) max-w-2xl leading-relaxed">
        {isId
          ? 'Daftar seluruh halaman, modul instrumen penggaris digital, kalkulator konversi, dan dokumen legalitas resmi di penggarisonline.com.'
          : 'Full directory of all measurement utilities, calibration modules, mathematical guides, and official legal documentation.'}
      </p>
    </div>

    <!-- Sitemap Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Card 1: Tools -->
      <div class="p-6 rounded-2xl bg-(--card) border border-(--border) space-y-4 shadow-sm hover:border-indigo-500/40 transition-colors">
        <div class="flex items-center gap-2 text-indigo-600 dark:text-cyan-400 font-bold text-base">
          <span>📐</span>
          <h2>{isId ? 'Alat & Mode Penggaris' : 'Measurement Tools & Modes'}</h2>
        </div>
        <ul class="space-y-2.5 text-xs text-(--muted-foreground)">
          <li>
            <a href="/" class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="font-semibold text-(--foreground) group-hover:underline">{isId ? 'Beranda Penggaris Online HP' : 'Online Screen Ruler Home'}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-(--muted) border border-(--border)">1:1</span>
            </a>
          </li>
          <li>
            <a href="/#kalibrasi" class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Kalibrasi Kartu ATM / e-KTP' : 'Card Calibration (ISO 7810)'}</span>
              <span class="text-[10px] text-emerald-500 font-bold">85.6 mm</span>
            </a>
          </li>
          <li>
            <a href="/" class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Jangka Sorong (Vernier Caliper)' : 'Digital Caliper Pins'}</span>
              <span class="text-[10px] text-indigo-500">Dual Pin</span>
            </a>
          </li>
          <li>
            <a href="/" class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Pengukur Luas 2D (Area Bidang)' : '2D Area & Rectangle Ruler'}</span>
              <span class="text-[10px] text-amber-500">W × H</span>
            </a>
          </li>
          <li>
            <a href="/" class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Pengukur Lingkaran & Diameter' : 'Circle & Diameter Ruler'}</span>
              <span class="text-[10px] text-cyan-500">Ø + π</span>
            </a>
          </li>
          <li>
            <a href="/" class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Mode Penggaris Tepi Layar' : 'Screen Edge Ruler Mode'}</span>
              <span class="text-[10px] text-purple-500">Edge</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Card 2: Legal -->
      <div class="p-6 rounded-2xl bg-(--card) border border-(--border) space-y-4 shadow-sm hover:border-indigo-500/40 transition-colors">
        <div class="flex items-center gap-2 text-indigo-600 dark:text-cyan-400 font-bold text-base">
          <span>🛡️</span>
          <h2>{isId ? 'Kebijakan Legal & Kepatuhan' : 'Legal & AdSense Policies'}</h2>
        </div>
        <ul class="space-y-2.5 text-xs text-(--muted-foreground)">
          <li>
            <a href={isId ? '/privacy-policy' : '/en/privacy-policy'} class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="font-semibold text-(--foreground) group-hover:underline">{isId ? 'Kebijakan Privasi' : 'Privacy Policy'}</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">AdSense</span>
            </a>
          </li>
          <li>
            <a href={isId ? '/terms-conditions' : '/en/terms-conditions'} class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Syarat & Ketentuan' : 'Terms & Conditions'}</span>
              <span class="text-[10px]">Anti-Bot</span>
            </a>
          </li>
          <li>
            <a href={isId ? '/disclaimer' : '/en/disclaimer'} class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Penafian Resmi' : 'Disclaimer'}</span>
              <span class="text-[10px]">Precision</span>
            </a>
          </li>
          <li>
            <a href={isId ? '/cookie-policy' : '/en/cookie-policy'} class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Kebijakan Kuki' : 'Cookie Policy'}</span>
              <span class="text-[10px]">GDPR</span>
            </a>
          </li>
          <li>
            <a href={isId ? '/about-us' : '/en/about-us'} class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Tentang Kami' : 'About Us'}</span>
              <span class="text-[10px]">Company</span>
            </a>
          </li>
          <li>
            <a href={isId ? '/contact-us' : '/en/contact-us'} class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Hubungi Kami' : 'Contact Us'}</span>
              <span class="text-[10px]">Support</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Card 3: Guides & FAQ -->
      <div class="p-6 rounded-2xl bg-(--card) border border-(--border) space-y-4 shadow-sm hover:border-indigo-500/40 transition-colors">
        <div class="flex items-center gap-2 text-indigo-600 dark:text-cyan-400 font-bold text-base">
          <span>❓</span>
          <h2>{isId ? 'Panduan & Tanya Jawab (FAQ)' : 'Guides & FAQ Section'}</h2>
        </div>
        <ul class="space-y-2.5 text-xs text-(--muted-foreground)">
          <li>
            <a href="/#faq" class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="font-semibold text-(--foreground) group-hover:underline">{isId ? 'Pusat FAQ Penggaris Online' : 'FAQ Center'}</span>
              <span class="text-[10px] text-indigo-500">12 Q&amp;A</span>
            </a>
          </li>
          <li>
            <a href="/#faq" class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Mengukur CM Pakai HP' : 'How to Measure on Phone'}</span>
              <span class="text-[10px]">Guide</span>
            </a>
          </li>
          <li>
            <a href="/#faq" class="hover:text-indigo-600 dark:hover:text-cyan-400 flex items-center justify-between group">
              <span class="group-hover:underline">{isId ? 'Rumus Konversi CM, MM, & Inci' : 'Metric to Imperial Formulas'}</span>
              <span class="text-[10px] font-mono">1 in = 2.54 cm</span>
            </a>
          </li>
        </ul>
      </div>

    </div>
  </main>

  <Footer currentLang={lang} />
</Layout>
