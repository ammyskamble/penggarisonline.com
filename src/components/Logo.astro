---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "w-9 h-9", size = 512 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 512 512"
  width={size}
  height={size}
  class={className}
  aria-label="Penggaris Online Logo"
  role="img"
>
  <defs>
    <linearGradient id="logo-grad" x1="84%" y1="87%" x2="16%" y2="13%">
      <stop offset="0%" stop-color="#f43f5e"></stop>
      <stop offset="50%" stop-color="#ec4899"></stop>
      <stop offset="100%" stop-color="#8b5cf6"></stop>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#000000" flood-opacity="0.40"></feDropShadow>
    </filter>
    <filter id="icon-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.35"></feDropShadow>
    </filter>
    <filter id="text-shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.4"></feDropShadow>
    </filter>
    <clipPath id="shape-clip">
      <rect x="10" y="10" width="492" height="492" rx="120" ry="120"></rect>
    </clipPath>
  </defs>
  <rect x="10" y="10" width="492" height="492" rx="120" ry="120" fill="url(#logo-grad)" filter="url(#shadow)"></rect>
  <g transform="translate(256, 256) rotate(0) translate(-256, -256)" filter="url(#icon-shadow)">
    <svg x="79.36" y="79.36" width="353.28" height="353.28" viewBox="0 0 24 24" fill="none" stroke="#a3ff1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14.086 18.412A2 2 0 0112.67 19H5v-7.672a2 2 0 01.586-1.414L11.75 3.75a6 6 0 118.49 8.49z"></path>
      <path d="M16 8 2 22"></path>
      <path d="M17.488 15H9"></path>
    </svg>
  </g>
</svg>
