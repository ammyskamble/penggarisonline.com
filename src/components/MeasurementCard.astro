---
// MeasurementCard.astro
---

<div class="w-full bg-(--card) border border-(--border) rounded-2xl p-5 sm:p-6 shadow-md transition-all">
  <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
    <!-- Left: Big Realtime Dimension Readout -->
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-500 dark:text-cyan-400 flex items-center gap-1.5">
          <span id="readout-pulse-dot" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="readout-title-text">Hasil Pengukuran Real-Time</span>
        </span>
        <span id="readout-subtitle-text" class="text-xs text-(--muted-foreground)">• Mode 1D (Jarak A ke B)</span>
      </div>

      <div class="flex items-baseline gap-3 flex-wrap">
        <span id="readout-primary-value" class="text-4xl sm:text-5xl font-extrabold font-mono-tabular tracking-tight text-(--foreground)">
          5.00
        </span>
        <span id="readout-primary-unit" class="text-2xl sm:text-3xl font-bold text-indigo-600 dark:text-cyan-400">
          cm
        </span>
        <span id="readout-fraction-badge" class="px-2.5 py-1 rounded-lg bg-(--muted) border border-(--border) text-xs sm:text-sm font-semibold font-mono text-(--muted-foreground)">
          ≈ 1 15/16"
        </span>
      </div>
    </div>

    <!-- Center: Dynamic Detailed Conversion Metrics (Pills) -->
    <!-- 1D Metric Grid -->
    <div id="metrics-group-1d" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 w-full lg:w-auto">
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Sentimeter</span>
        <span id="metric-cm" class="text-base font-bold font-mono-tabular text-(--foreground)">5.00 cm</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Milimeter</span>
        <span id="metric-mm" class="text-base font-bold font-mono-tabular text-(--foreground)">50.0 mm</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Inci (Desimal)</span>
        <span id="metric-inch" class="text-base font-bold font-mono-tabular text-(--foreground)">1.969 in</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Piksel Layar</span>
        <span id="metric-px" class="text-base font-bold font-mono-tabular text-(--foreground)">189 px</span>
      </div>
    </div>

    <!-- 2D Metric Grid (Hidden by default) -->
    <div id="metrics-group-2d" class="hidden grid-cols-2 sm:grid-cols-4 gap-2.5 w-full lg:w-auto">
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Panjang (X)</span>
        <span id="metric-2d-w" class="text-base font-bold font-mono-tabular text-(--foreground)">5.00 cm</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Lebar (Y)</span>
        <span id="metric-2d-h" class="text-base font-bold font-mono-tabular text-(--foreground)">3.50 cm</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Luas Bidang</span>
        <span id="metric-2d-area" class="text-base font-bold font-mono-tabular text-indigo-600 dark:text-cyan-400">17.50 cm²</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Garis Diagonal</span>
        <span id="metric-2d-diag" class="text-base font-bold font-mono-tabular text-(--foreground)">6.10 cm</span>
      </div>
    </div>

    <!-- Circle Metric Grid (Hidden by default) -->
    <div id="metrics-group-circle" class="hidden grid-cols-2 sm:grid-cols-4 gap-2.5 w-full lg:w-auto">
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Diameter (Ø)</span>
        <span id="metric-circle-dia" class="text-base font-bold font-mono-tabular text-(--foreground)">3.00 cm</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Jari-Jari (r)</span>
        <span id="metric-circle-rad" class="text-base font-bold font-mono-tabular text-(--foreground)">1.50 cm</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Keliling</span>
        <span id="metric-circle-circ" class="text-base font-bold font-mono-tabular text-(--foreground)">9.42 cm</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Luas Lingkaran</span>
        <span id="metric-circle-area" class="text-base font-bold font-mono-tabular text-indigo-600 dark:text-cyan-400">7.07 cm²</span>
      </div>
    </div>

    <!-- Angle Metric Grid (Hidden by default) -->
    <div id="metrics-group-angle" class="hidden grid-cols-2 sm:grid-cols-3 gap-2.5 w-full lg:w-auto">
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Besar Sudut</span>
        <span id="metric-angle-deg" class="text-base font-bold font-mono-tabular text-indigo-600 dark:text-cyan-400">45.0°</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Radian</span>
        <span id="metric-angle-rad" class="text-base font-bold font-mono-tabular text-(--foreground)">0.785 rad</span>
      </div>
      <div class="px-3.5 py-2 rounded-xl bg-(--muted)/60 border border-(--border) flex flex-col">
        <span class="text-[11px] text-(--muted-foreground) font-medium">Kategori</span>
        <span id="metric-angle-type" class="text-base font-bold text-(--foreground)">Sudut Lancip</span>
      </div>
    </div>

    <!-- Right: Micro Steppers & One-Click Copy -->
    <div class="flex items-center gap-2 self-stretch lg:self-auto justify-end flex-wrap">
      <!-- Micro Adjustment Steppers (Adapts dynamically to active tool: 1D, 2D, Circle, Angle) -->
      <div id="stepper-controls" class="flex items-center bg-(--muted) p-1 rounded-xl border border-(--border)">
        <button
          type="button"
          id="btn-quick-step-minus"
          class="step-btn px-2.5 py-1.5 rounded-lg hover:bg-(--card) text-xs font-bold text-(--foreground) transition-colors"
          title="Kurangi 1 satuan"
        >
          -1 mm
        </button>
        <div class="w-px h-4 bg-(--border) mx-0.5"></div>
        <button
          type="button"
          id="btn-quick-step-plus"
          class="step-btn px-2.5 py-1.5 rounded-lg hover:bg-(--card) text-xs font-bold text-(--foreground) transition-colors"
          title="Tambah 1 satuan"
        >
          +1 mm
        </button>
      </div>

      <!-- Copy Button with tactile feedback -->
      <button
        type="button"
        id="btn-copy-measurement"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-semibold shadow-sm shadow-indigo-600/20 transition-all hover:scale-102 active:scale-98 cursor-pointer"
      >
        <svg id="copy-icon-default" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg id="copy-icon-check" class="w-4 h-4 hidden text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span id="copy-btn-text">Salin Ukuran</span>
      </button>
    </div>
  </div>

  <!-- Bottom Row: Dedicated Manual Adjustment & Precision Steppers Bar -->
  <div class="mt-4 pt-4 border-t border-(--border) flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2 text-(--muted-foreground) font-semibold shrink-0">
      <svg class="w-4 h-4 text-indigo-500 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="4" y1="21" x2="4" y2="14"></line>
        <line x1="4" y1="10" x2="4" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12" y2="3"></line>
        <line x1="20" y1="21" x2="20" y2="16"></line>
        <line x1="20" y1="12" x2="20" y2="3"></line>
        <line x1="1" y1="14" x2="7" y2="14"></line>
        <line x1="9" y1="8" x2="15" y2="8"></line>
        <line x1="17" y1="16" x2="23" y2="16"></line>
      </svg>
      <span>Atur Ukuran Manual (Ketik / Tombol):</span>
    </div>

    <!-- 1D Manual Adjustment Controls -->
    <div id="manual-group-1d" class="flex flex-wrap items-center gap-2">
      <span class="text-(--muted-foreground) font-medium">Panjang:</span>
      <div class="flex items-center bg-(--muted) p-1 rounded-xl border border-(--border)">
        <button type="button" class="btn-step-1d px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-10" title="Kurangi 1 cm">-1 cm</button>
        <button type="button" class="btn-step-1d px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-1" title="Kurangi 1 mm">-1 mm</button>
        <div class="mx-1 flex items-center bg-(--card) px-2 py-0.5 rounded-lg border border-(--border) shadow-inner">
          <input
            type="number"
            id="input-manual-1d"
            step="0.01"
            min="0.01"
            class="w-16 bg-transparent text-center font-mono-tabular font-bold text-xs text-(--foreground) focus:outline-none"
            placeholder="5.00"
            aria-label="Input manual panjang penggaris"
          />
          <span id="label-manual-1d-unit" class="text-[11px] font-bold text-indigo-500 dark:text-cyan-400 ml-1">cm</span>
        </div>
        <button type="button" class="btn-step-1d px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="1" title="Tambah 1 mm">+1 mm</button>
        <button type="button" class="btn-step-1d px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="10" title="Tambah 1 cm">+1 cm</button>
      </div>
    </div>

    <!-- 2D Manual Adjustment Controls (Hidden by default) -->
    <div id="manual-group-2d" class="hidden flex-wrap items-center gap-3">
      <!-- Panjang (X) -->
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-indigo-500 dark:text-cyan-400">P (X):</span>
        <div class="flex items-center bg-(--muted) p-1 rounded-xl border border-(--border)">
          <button type="button" class="btn-step-2d-w px-1.5 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-10" title="Kurangi 1 cm">-1cm</button>
          <button type="button" class="btn-step-2d-w px-1.5 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-1" title="Kurangi 1 mm">-1mm</button>
          <div class="mx-1 flex items-center bg-(--card) px-2 py-0.5 rounded-lg border border-(--border) shadow-inner">
            <input
              type="number"
              id="input-manual-2d-w"
              step="0.05"
              min="0.1"
              class="w-14 bg-transparent text-center font-mono-tabular font-bold text-xs text-(--foreground) focus:outline-none"
              placeholder="5.0"
              aria-label="Input manual panjang 2D"
            />
            <span class="text-[10px] font-bold text-(--muted-foreground) ml-0.5">cm</span>
          </div>
          <button type="button" class="btn-step-2d-w px-1.5 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="1" title="Tambah 1 mm">+1mm</button>
          <button type="button" class="btn-step-2d-w px-1.5 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="10" title="Tambah 1 cm">+1cm</button>
        </div>
      </div>

      <!-- Lebar (Y) -->
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-indigo-500 dark:text-cyan-400">L (Y):</span>
        <div class="flex items-center bg-(--muted) p-1 rounded-xl border border-(--border)">
          <button type="button" class="btn-step-2d-h px-1.5 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-10" title="Kurangi 1 cm">-1cm</button>
          <button type="button" class="btn-step-2d-h px-1.5 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-1" title="Kurangi 1 mm">-1mm</button>
          <div class="mx-1 flex items-center bg-(--card) px-2 py-0.5 rounded-lg border border-(--border) shadow-inner">
            <input
              type="number"
              id="input-manual-2d-h"
              step="0.05"
              min="0.1"
              class="w-14 bg-transparent text-center font-mono-tabular font-bold text-xs text-(--foreground) focus:outline-none"
              placeholder="3.5"
              aria-label="Input manual lebar 2D"
            />
            <span class="text-[10px] font-bold text-(--muted-foreground) ml-0.5">cm</span>
          </div>
          <button type="button" class="btn-step-2d-h px-1.5 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="1" title="Tambah 1 mm">+1mm</button>
          <button type="button" class="btn-step-2d-h px-1.5 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="10" title="Tambah 1 cm">+1cm</button>
        </div>
      </div>
    </div>

    <!-- Circle Manual Adjustment Controls (Hidden by default) -->
    <div id="manual-group-circle" class="hidden flex-wrap items-center gap-2">
      <span class="text-(--muted-foreground) font-medium">Diameter (Ø):</span>
      <div class="flex items-center bg-(--muted) p-1 rounded-xl border border-(--border)">
        <button type="button" class="btn-step-circle px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-5" title="Kurangi 5 mm">-5 mm</button>
        <button type="button" class="btn-step-circle px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-1" title="Kurangi 1 mm">-1 mm</button>
        <div class="mx-1 flex items-center bg-(--card) px-2 py-0.5 rounded-lg border border-(--border) shadow-inner">
          <input
            type="number"
            id="input-manual-circle"
            step="0.5"
            min="2"
            class="w-16 bg-transparent text-center font-mono-tabular font-bold text-xs text-(--foreground) focus:outline-none"
            placeholder="30.0"
            aria-label="Input manual diameter lingkaran"
          />
          <span class="text-[11px] font-bold text-indigo-500 dark:text-cyan-400 ml-1">mm</span>
        </div>
        <button type="button" class="btn-step-circle px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="1" title="Tambah 1 mm">+1 mm</button>
        <button type="button" class="btn-step-circle px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="5" title="Tambah 5 mm">+5 mm</button>
      </div>
    </div>

    <!-- Angle Manual Adjustment Controls (Hidden by default) -->
    <div id="manual-group-angle" class="hidden flex-wrap items-center gap-2">
      <span class="text-(--muted-foreground) font-medium">Besar Sudut:</span>
      <div class="flex items-center bg-(--muted) p-1 rounded-xl border border-(--border)">
        <button type="button" class="btn-step-angle px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-5" title="Kurangi 5 Derajat">-5°</button>
        <button type="button" class="btn-step-angle px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="-1" title="Kurangi 1 Derajat">-1°</button>
        <div class="mx-1 flex items-center bg-(--card) px-2 py-0.5 rounded-lg border border-(--border) shadow-inner">
          <input
            type="number"
            id="input-manual-angle"
            step="0.5"
            min="0"
            max="360"
            class="w-16 bg-transparent text-center font-mono-tabular font-bold text-xs text-(--foreground) focus:outline-none"
            placeholder="45.0"
            aria-label="Input manual besar sudut derajat"
          />
          <span class="text-[12px] font-bold text-indigo-500 dark:text-cyan-400 ml-0.5">°</span>
        </div>
        <button type="button" class="btn-step-angle px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="1" title="Tambah 1 Derajat">+1°</button>
        <button type="button" class="btn-step-angle px-2 py-1 rounded-lg hover:bg-(--card) font-bold text-xs text-(--foreground) transition-colors cursor-pointer" data-step="5" title="Tambah 5 Derajat">+5°</button>
      </div>

      <!-- Quick Angle Presets in Card -->
      <div class="flex items-center gap-1 overflow-x-auto">
        <button type="button" class="btn-quick-angle-pill px-2 py-1 rounded-lg bg-(--muted) hover:bg-(--card) border border-(--border) text-[11px] font-bold text-(--foreground) transition-all cursor-pointer" data-angle="30">30°</button>
        <button type="button" class="btn-quick-angle-pill px-2 py-1 rounded-lg bg-(--muted) hover:bg-(--card) border border-(--border) text-[11px] font-bold text-(--foreground) transition-all cursor-pointer" data-angle="45">45°</button>
        <button type="button" class="btn-quick-angle-pill px-2 py-1 rounded-lg bg-(--muted) hover:bg-(--card) border border-(--border) text-[11px] font-bold text-(--foreground) transition-all cursor-pointer" data-angle="60">60°</button>
        <button type="button" class="btn-quick-angle-pill px-2 py-1 rounded-lg bg-(--muted) hover:bg-(--card) border border-(--border) text-[11px] font-bold text-(--foreground) transition-all cursor-pointer" data-angle="90">90°</button>
        <button type="button" class="btn-quick-angle-pill px-2 py-1 rounded-lg bg-(--muted) hover:bg-(--card) border border-(--border) text-[11px] font-bold text-(--foreground) transition-all cursor-pointer" data-angle="180">180°</button>
      </div>
    </div>
  </div>
</div>
