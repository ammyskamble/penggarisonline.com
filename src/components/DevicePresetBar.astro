---
// DevicePresetBar.astro
import { DEVICE_PRESETS } from '../scripts/ruler-engine.js';
---

<div class="w-full border-b border-(--border) bg-(--card)/50 backdrop-blur-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5">
    <!-- Zoom Warning Banner (Hidden by default, shown when zoom != 100%) -->
    <div id="zoom-alert" class="hidden mb-2.5 px-3.5 py-2 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 flex items-center justify-between text-xs sm:text-sm">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <span>
          <strong>Perhatian:</strong> Zoom browser Anda saat ini <span id="zoom-percentage" class="font-bold">100%</span>. Untuk akurasi penggaris 1:1, mohon reset zoom ke <strong>100%</strong> (Tekan <kbd class="px-1 py-0.5 rounded bg-(--card) border border-(--border) text-[11px]">Ctrl</kbd> + <kbd class="px-1 py-0.5 rounded bg-(--card) border border-(--border) text-[11px]">0</kbd>).
        </span>
      </div>
      <button type="button" onclick="document.getElementById('zoom-alert').classList.add('hidden')" class="text-amber-600 dark:text-amber-400 hover:opacity-75 font-bold ml-2">×</button>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 text-xs sm:text-sm">
      <!-- Status Badge -->
      <div class="flex items-center gap-2 flex-wrap">
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-(--muted) border border-(--border)">
          <span id="calib-status-indicator" class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span class="text-(--muted-foreground)">Status:</span>
          <strong id="calib-status-text" class="font-semibold text-(--foreground)">Deteksi Otomatis</strong>
        </div>

        <div class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-(--muted) border border-(--border)">
          <span class="text-(--muted-foreground)">Kerapatan Layar:</span>
          <span id="screen-ppi-display" class="font-mono font-bold text-indigo-600 dark:text-cyan-400">96.0 PPI</span>
        </div>
      </div>

      <!-- Quick Preset Selector -->
      <div class="flex items-center gap-2 ml-auto">
        <label for="device-preset-select" class="hidden sm:inline-block text-(--muted-foreground) whitespace-nowrap text-xs">
          Preset Perangkat:
        </label>
        <div class="relative">
          <select
            id="device-preset-select"
            class="appearance-none pl-3 pr-8 py-1.5 rounded-xl bg-(--card) border border-(--border) text-xs sm:text-sm font-medium text-(--foreground) hover:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 focus:outline-none transition-colors cursor-pointer"
          >
            <option value="auto">⚡ Deteksi Otomatis</option>
            <optgroup label="📱 Smartphone Terpopuler (Indonesia)">
              <option value="460">Apple iPhone 13/14/15/16 (460 PPI)</option>
              <option value="326">Apple iPhone 11 / XR (326 PPI)</option>
              <option value="505">Samsung Galaxy S24 Ultra (505 PPI)</option>
              <option value="416">Samsung Galaxy S23 / S24 (416 PPI)</option>
              <option value="390">Samsung Galaxy A54 / A55 5G (390 PPI)</option>
              <option value="399">Samsung Galaxy A14 / A15 / A05s (399 PPI)</option>
              <option value="395">Xiaomi Redmi Note 12 / 13 (395 PPI)</option>
              <option value="446">Poco X5 / X6 Pro (446 PPI)</option>
              <option value="394">Oppo Reno 10 / 11 / 12 (394 PPI)</option>
              <option value="453">Vivo V27 / V29 / V30 (453 PPI)</option>
              <option value="396">Infinix Note 30 / 40 / Hot 40 Pro (396 PPI)</option>
            </optgroup>
            <optgroup label="💻 Laptop & Komputer">
              <option value="157.4">Laptop 14.0" Full HD (157.4 PPI)</option>
              <option value="141.2">Laptop 15.6" Full HD (141.2 PPI)</option>
              <option value="111.9">Laptop 14.0" HD 1366x768 (111.9 PPI)</option>
              <option value="224">MacBook Air 13.3" / 13.6" (224 PPI)</option>
              <option value="254">MacBook Pro 14" (254 PPI)</option>
              <option value="91.8">Monitor PC 24" FHD (91.8 PPI)</option>
              <option value="108.8">Monitor PC 27" 2K QHD (108.8 PPI)</option>
            </optgroup>
            <optgroup label="📱 Tablet">
              <option value="264">Apple iPad 10.2" / 10.9" / Air (264 PPI)</option>
              <option value="274">Samsung Galaxy Tab S9 11" (274 PPI)</option>
            </optgroup>
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-(--muted-foreground)">
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>

        <button
          type="button"
          id="btn-quick-calibrate"
          class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-600 dark:text-cyan-400 border border-indigo-500/20 text-xs font-semibold transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span class="hidden sm:inline">Ubah</span> Kalibrasi
        </button>
      </div>
    </div>
  </div>
</div>
