---
// RulerCanvas.astro
import { COIN_PRESETS } from '../scripts/ruler-engine.js';
---

<div class="relative w-full overflow-hidden select-none bg-(--card) border-y md:border md:rounded-2xl border-(--border) shadow-md">
  <!-- Top Tool Selection Tabs -->
  <div class="px-3 sm:px-4 py-2 bg-(--muted)/80 border-b border-(--border) flex flex-wrap items-center justify-between gap-2 text-xs">
    <!-- Tool Modes Tabs -->
    <div class="flex items-center gap-1 bg-(--card) p-1 rounded-xl border border-(--border) shadow-inner overflow-x-auto max-w-full">
      <button
        type="button"
        data-tool-btn="1d"
        class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-(--primary) text-white shadow-xs"
      >
        📏 Penggaris 1D
      </button>
      <button
        type="button"
        data-tool-btn="2d"
        class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-medium text-(--muted-foreground) hover:text-(--foreground) transition-all"
      >
        📐 Penggaris 2D (P × L)
      </button>
      <button
        type="button"
        data-tool-btn="circle"
        class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-medium text-(--muted-foreground) hover:text-(--foreground) transition-all"
      >
        ⭕ Lingkaran & Koin
      </button>
      <button
        type="button"
        data-tool-btn="angle"
        class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-medium text-(--muted-foreground) hover:text-(--foreground) transition-all"
      >
        🧭 Busur Derajat
      </button>
    </div>

    <!-- Quick Actions (Lock, Flip, Reset) -->
    <div class="flex items-center gap-1.5 ml-auto">
      <!-- CALIPER LOCK BUTTON -->
      <button
        type="button"
        id="btn-toggle-lock"
        class="px-3 py-1.5 rounded-xl border border-(--border) bg-(--card) hover:bg-(--muted) text-xs font-bold flex items-center gap-1.5 transition-all shadow-xs cursor-pointer"
        title="Kunci geser sentuhan layar agar objek fisik tidak menggeser penanda"
      >
        <span id="lock-icon-unlocked" class="block text-emerald-500">🔓</span>
        <span id="lock-icon-locked" class="hidden text-amber-500">🔒</span>
        <span id="lock-btn-text" class="text-(--foreground)">Kunci Layar (Sentuh)</span>
      </button>

      <!-- Flip 0 direction (1D Only) -->
      <button
        type="button"
        id="btn-flip-zero"
        class="px-2.5 py-1.5 rounded-xl bg-(--card) hover:bg-(--muted) text-(--foreground) border border-(--border) text-xs font-medium flex items-center gap-1 transition-colors cursor-pointer"
        title="Balik Titik Nol (0)"
      >
        <svg class="w-3.5 h-3.5 text-indigo-500 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m16 3 4 4-4 4"></path>
          <path d="M20 7H4"></path>
          <path d="m8 21-4-4 4-4"></path>
          <path d="M4 17h16"></path>
        </svg>
        <span class="hidden sm:inline">Balik 0</span>
      </button>

      <!-- Reset Button -->
      <button
        type="button"
        id="btn-reset-caliper"
        class="px-2.5 py-1.5 rounded-xl bg-(--card) hover:bg-(--muted) text-(--foreground) border border-(--border) text-xs font-medium transition-colors cursor-pointer"
        title="Reset Ukuran ke Default"
      >
        Reset
      </button>
    </div>
  </div>

  <!-- Locked Banner Alert (Visible when calipers touch is locked) -->
  <div id="locked-status-banner" class="hidden px-4 py-2 bg-amber-500/15 border-b border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-semibold flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
      <span><strong>Kunci Layar Aktif (Touch Locked):</strong> Geser sentuhan langsung di layar dikunci agar objek fisik tidak menggeser penanda. Tombol penyesuaian manual & angka di bawah tetap aktif berfungsi.</span>
    </div>
    <button type="button" id="btn-unlock-banner" class="px-2.5 py-1 rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold transition-all shadow-xs cursor-pointer shrink-0">Buka Kunci Layar</button>
  </div>

  <!-- ============================================== -->
  <!-- CANVAS VIEW 1: 1D LINEAR RULER                -->
  <!-- ============================================== -->
  <div
    id="view-1d-canvas"
    class="relative w-full h-56 sm:h-64 overflow-hidden touch-none cursor-crosshair bg-gradient-to-b from-(--card) via-(--background) to-(--card)"
  >
    <svg id="ruler-svg" class="absolute inset-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
      <g id="metric-ticks-group"></g>
      <g id="imperial-ticks-group"></g>
    </svg>

    <!-- Highlighted Active 1D Measurement Area -->
    <div
      id="caliper-highlight-area"
      class="absolute top-0 bottom-0 pointer-events-none bg-indigo-500/15 dark:bg-cyan-400/15 border-x border-indigo-500/50 dark:border-cyan-400/50 transition-colors"
    >
      <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-none">
        <div id="ruler-float-dimension-pill" class="px-2.5 py-1 rounded-full glass-panel shadow-md border border-indigo-500/30 dark:border-cyan-400/30 text-[11px] sm:text-xs font-bold font-mono-tabular text-indigo-600 dark:text-cyan-300 flex items-center gap-1.5 transition-opacity duration-200">
          <span id="ruler-float-dimension">0.00 cm</span>
        </div>
      </div>
    </div>

    <!-- Caliper Slider A (Start Mark) -->
    <div
      id="caliper-pointer-a"
      role="slider"
      tabindex="0"
      aria-label="Penanda Penggaris A"
      aria-valuemin="0"
      aria-valuenow="40"
      class="absolute top-0 bottom-0 w-8 -ml-4 z-20 flex flex-col items-center justify-between cursor-ew-resize group touch-none focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
    >
      <div class="caliper-pin w-6 h-6 rounded-full bg-indigo-600 dark:bg-cyan-500 text-white shadow-lg flex items-center justify-center border-2 border-white dark:border-slate-900 group-hover:scale-110 group-focus:scale-110 active:scale-95 transition-transform shrink-0">
        <span class="text-[10px] font-bold">A</span>
      </div>
      <div class="caliper-line w-0.5 flex-1 bg-indigo-600 dark:bg-cyan-400 opacity-90 shadow-[0_0_8px_rgba(79,70,229,0.6)]"></div>
      <div class="caliper-arrow mb-0.5 w-0 h-0 border-x-4 border-x-transparent border-t-6 border-t-indigo-600 dark:border-t-cyan-400 shrink-0"></div>
    </div>

    <!-- Caliper Slider B (End Mark) -->
    <div
      id="caliper-pointer-b"
      role="slider"
      tabindex="0"
      aria-label="Penanda Penggaris B"
      aria-valuemin="0"
      aria-valuenow="229"
      class="absolute top-0 bottom-0 w-8 -ml-4 z-20 flex flex-col items-center justify-between cursor-ew-resize group touch-none focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
    >
      <div class="caliper-pin w-6 h-6 rounded-full bg-indigo-600 dark:bg-cyan-500 text-white shadow-lg flex items-center justify-center border-2 border-white dark:border-slate-900 group-hover:scale-110 group-focus:scale-110 active:scale-95 transition-transform shrink-0">
        <span class="text-[10px] font-bold">B</span>
      </div>
      <div class="caliper-line w-0.5 flex-1 bg-indigo-600 dark:bg-cyan-400 opacity-90 shadow-[0_0_8px_rgba(79,70,229,0.6)]"></div>
      <div class="caliper-arrow mb-0.5 w-0 h-0 border-x-4 border-x-transparent border-t-6 border-t-indigo-600 dark:border-t-cyan-400 shrink-0"></div>
    </div>
  </div>

  <!-- ============================================== -->
  <!-- CANVAS VIEW 2: 2D MEASURING CANVAS (P x L)    -->
  <!-- ============================================== -->
  <div
    id="view-2d-canvas"
    class="relative w-full h-[400px] sm:h-[460px] overflow-hidden hidden touch-none bg-gradient-to-br from-(--card) via-(--background) to-(--card)"
  >
    <!-- Background SVG for 2D Axis Rulers (Top X & Left Y) -->
    <svg id="ruler-2d-svg" class="absolute inset-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
      <g id="ticks-2d-x"></g>
      <g id="ticks-2d-y"></g>
    </svg>

    <!-- 2D Resizable Bounding Box Caliper -->
    <div
      id="caliper-box-2d"
      class="absolute rounded-xl border-2 border-indigo-500 dark:border-cyan-400 bg-indigo-500/10 dark:bg-cyan-500/10 shadow-lg flex flex-col items-center justify-center"
      style="left: 60px; top: 60px; width: 220px; height: 160px;"
    >
      <!-- Center Info Badge (Width x Height + Area) -->
      <div class="px-3 py-1.5 rounded-xl glass-panel shadow-md border border-indigo-500/30 text-center pointer-events-none">
        <div id="badge-2d-dimensions" class="text-xs sm:text-sm font-extrabold font-mono-tabular text-indigo-600 dark:text-cyan-300">
          5.00 × 3.50 cm
        </div>
        <div id="badge-2d-area" class="text-[11px] font-mono text-(--muted-foreground)">
          Luas: 17.50 cm²
        </div>
      </div>

      <!-- Corner Handle (Bottom-Right Resize Handle) -->
      <div
        id="handle-2d-corner"
        class="absolute -right-3.5 -bottom-3.5 w-7 h-7 rounded-full bg-indigo-600 dark:bg-cyan-500 border-2 border-white dark:border-slate-900 shadow-md flex items-center justify-center cursor-nwse-resize hover:scale-110 active:scale-95 transition-transform z-30 touch-none"
        title="Tarik untuk mengubah panjang & lebar kotak"
      >
        <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M15 3h6v6m0 6v6h-6M9 21H3v-6m0-6V3h6"></path>
        </svg>
      </div>

      <!-- Top-Left Position Anchor -->
      <div
        id="handle-2d-drag"
        class="absolute -left-3 -top-3 w-6 h-6 rounded-full bg-indigo-600 dark:bg-cyan-500 border-2 border-white dark:border-slate-900 shadow-md flex items-center justify-center cursor-move hover:scale-110 active:scale-95 transition-transform z-30 touch-none"
        title="Geser posisi kotak"
      >
        <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <path d="M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3"></path>
        </svg>
      </div>
    </div>
  </div>

  <!-- ============================================== -->
  <!-- CANVAS VIEW 3: CIRCLE & COIN MEASURING TOOL    -->
  <!-- ============================================== -->
  <div
    id="view-circle-canvas"
    class="relative w-full h-[420px] sm:h-[480px] overflow-hidden hidden touch-none bg-gradient-to-br from-(--card) via-(--background) to-(--card) flex flex-col items-center justify-center p-4"
  >
    <!-- Top Coin Quick Presets -->
    <div class="absolute top-3 inset-x-3 flex flex-wrap items-center justify-center gap-1.5 z-20">
      <span class="text-[11px] font-semibold text-(--muted-foreground) mr-1">Preset Koin:</span>
      {COIN_PRESETS.map((coin) => (
        <button
          type="button"
          class="btn-coin-preset px-2 py-1 rounded-lg bg-(--card) hover:bg-(--muted) border border-(--border) text-[11px] font-medium text-(--foreground) transition-all shadow-xs"
          data-diameter={coin.diameterMm}
        >
          {coin.name.split('(')[0].trim()} ({coin.diameterMm} mm)
        </button>
      ))}
    </div>

    <!-- Center Circle Visual Caliper Container -->
    <div class="relative w-full h-full flex items-center justify-center">
      <!-- Interactive Circle SVG -->
      <svg id="circle-svg" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <!-- Concentric background reference circles -->
        <g id="circle-background-grid"></g>
        <!-- Center Crosshair -->
        <line id="crosshair-x" x1="0" y1="0" x2="0" y2="0" stroke="var(--border)" stroke-width="1" stroke-dasharray="3 3" />
        <line id="crosshair-y" x1="0" y1="0" x2="0" y2="0" stroke="var(--border)" stroke-width="1" stroke-dasharray="3 3" />

        <!-- Main Dynamic Caliper Circle -->
        <circle
          id="dynamic-caliper-circle"
          cx="0"
          cy="0"
          r="60"
          fill="color-mix(in oklch, var(--primary) 15%, transparent)"
          stroke="var(--primary)"
          stroke-width="2.5"
        />
        <!-- Diameter Line -->
        <line id="circle-diameter-line" x1="0" y1="0" x2="0" y2="0" stroke="var(--cyan-glow)" stroke-width="2" stroke-dasharray="4 2" />
      </svg>

      <!-- Center Floating Circle Badge -->
      <div id="circle-center-badge" class="absolute pointer-events-none px-3 py-1.5 rounded-xl glass-panel shadow-md border border-indigo-500/30 text-center">
        <div id="circle-badge-diameter" class="text-xs sm:text-sm font-extrabold font-mono-tabular text-indigo-600 dark:text-cyan-300">
          Ø 3.00 cm (30.0 mm)
        </div>
        <div id="circle-badge-sub" class="text-[10px] font-mono text-(--muted-foreground)">
          Keliling: 9.42 cm • r = 1.50 cm
        </div>
      </div>

      <!-- Circle Radius Resize Handle -->
      <div
        id="handle-circle-radius"
        class="absolute w-7 h-7 rounded-full bg-indigo-600 dark:bg-cyan-500 border-2 border-white dark:border-slate-900 shadow-lg flex items-center justify-center cursor-ew-resize hover:scale-110 active:scale-95 transition-transform z-30 touch-none"
        title="Geser tepi lingkaran untuk mencocokkan dengan koin atau cincin"
      >
        <span class="text-[10px] font-bold text-white">↔</span>
      </div>
    </div>

    <!-- Bottom Slider for Fine Diameter Tuning -->
    <div class="absolute bottom-3 inset-x-6 max-w-md mx-auto space-y-1 z-20">
      <div class="flex justify-between text-xs text-(--muted-foreground)">
        <span>Diameter:</span>
        <span id="circle-slider-label" class="font-mono font-bold text-(--foreground)">30.0 mm</span>
      </div>
      <input
        type="range"
        id="slider-circle-diameter"
        min="5"
        max="120"
        step="0.5"
        value="30"
        class="w-full h-2 rounded-lg bg-(--muted) appearance-none cursor-pointer"
      />
    </div>
  </div>

  <!-- ============================================== -->
  <!-- CANVAS VIEW 4: PROTRACTOR / ANGLE TOOL        -->
  <!-- ============================================== -->
  <div
    id="view-angle-canvas"
    class="relative w-full h-[420px] sm:h-[480px] overflow-hidden hidden touch-none bg-gradient-to-br from-(--card) via-(--background) to-(--card) flex flex-col items-center justify-center p-4"
  >
    <!-- Top Angle Quick Presets -->
    <div class="absolute top-3 inset-x-3 flex flex-wrap items-center justify-center gap-1.5 z-20">
      <span class="text-[11px] font-semibold text-(--muted-foreground) mr-1">Preset Sudut:</span>
      <button type="button" class="btn-canvas-angle-preset px-2 py-1 rounded-lg bg-(--card) hover:bg-(--muted) border border-(--border) text-[11px] font-medium text-(--foreground) transition-all shadow-xs cursor-pointer" data-angle="30">30°</button>
      <button type="button" class="btn-canvas-angle-preset px-2 py-1 rounded-lg bg-(--card) hover:bg-(--muted) border border-(--border) text-[11px] font-medium text-(--foreground) transition-all shadow-xs cursor-pointer" data-angle="45">45° (Siku/2)</button>
      <button type="button" class="btn-canvas-angle-preset px-2 py-1 rounded-lg bg-(--card) hover:bg-(--muted) border border-(--border) text-[11px] font-medium text-(--foreground) transition-all shadow-xs cursor-pointer" data-angle="60">60°</button>
      <button type="button" class="btn-canvas-angle-preset px-2 py-1 rounded-lg bg-(--card) hover:bg-(--muted) border border-(--border) text-[11px] font-medium text-(--foreground) transition-all shadow-xs cursor-pointer" data-angle="90">90° (Tegak Lurus)</button>
      <button type="button" class="btn-canvas-angle-preset px-2 py-1 rounded-lg bg-(--card) hover:bg-(--muted) border border-(--border) text-[11px] font-medium text-(--foreground) transition-all shadow-xs cursor-pointer" data-angle="120">120°</button>
      <button type="button" class="btn-canvas-angle-preset px-2 py-1 rounded-lg bg-(--card) hover:bg-(--muted) border border-(--border) text-[11px] font-medium text-(--foreground) transition-all shadow-xs cursor-pointer" data-angle="180">180° (Garis Lurus)</button>
    </div>

    <!-- Protractor Angle Canvas SVG -->
    <svg id="protractor-svg" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <!-- Protractor Degree Markings (0 - 180 / 360) -->
      <g id="protractor-markings"></g>
      <!-- Colored Angle Arc Fill -->
      <path id="angle-arc-path" fill="color-mix(in oklch, var(--primary) 20%, transparent)" stroke="var(--primary)" stroke-width="2" />
      <!-- Arm 1 Line -->
      <line id="angle-arm1-line" x1="0" y1="0" x2="0" y2="0" stroke="var(--primary)" stroke-width="3" stroke-linecap="round" />
      <!-- Arm 2 Line -->
      <line id="angle-arm2-line" x1="0" y1="0" x2="0" y2="0" stroke="var(--cyan-glow)" stroke-width="3" stroke-linecap="round" />
      <!-- Center Pivot -->
      <circle id="protractor-pivot" cx="0" cy="0" r="6" fill="var(--foreground)" />
    </svg>

    <!-- Arm 1 Draggable Handle Pin -->
    <div
      id="handle-angle-arm1"
      class="absolute w-7 h-7 rounded-full bg-indigo-600 text-white shadow-lg flex items-center justify-center border-2 border-white dark:border-slate-900 cursor-grab active:cursor-grabbing hover:scale-110 active:scale-95 transition-transform z-30 touch-none"
      title="Geser Jarum Sudut 1"
    >
      <span class="text-[10px] font-bold">1</span>
    </div>

    <!-- Arm 2 Draggable Handle Pin -->
    <div
      id="handle-angle-arm2"
      class="absolute w-7 h-7 rounded-full bg-cyan-500 text-white shadow-lg flex items-center justify-center border-2 border-white dark:border-slate-900 cursor-grab active:cursor-grabbing hover:scale-110 active:scale-95 transition-transform z-30 touch-none"
      title="Geser Jarum Sudut 2"
    >
      <span class="text-[10px] font-bold">2</span>
    </div>

    <!-- Center Protractor Angle Readout Badge -->
    <div class="absolute bottom-16 inset-x-4 max-w-sm mx-auto p-2.5 rounded-2xl glass-panel shadow-md border border-indigo-500/30 text-center z-20">
      <div class="text-[10px] font-bold uppercase tracking-wider text-(--muted-foreground)">
        Besar Sudut Terukur
      </div>
      <div id="angle-degrees-readout" class="text-2xl sm:text-3xl font-black font-mono-tabular text-indigo-600 dark:text-cyan-300 leading-tight">
        45.0°
      </div>
      <div id="angle-sub-readout" class="text-[11px] font-mono text-(--foreground) font-semibold">
        Sudut Lancip (&lt; 90°) • 0.785 rad
      </div>
    </div>

    <!-- Bottom Slider & Stepper for Fine Angle Tuning -->
    <div class="absolute bottom-2.5 inset-x-4 max-w-md mx-auto space-y-1 z-20 bg-(--card)/85 backdrop-blur-md px-3 py-1.5 rounded-xl border border-(--border) shadow-md">
      <div class="flex items-center justify-between text-xs text-(--muted-foreground)">
        <span class="font-medium">Putar Sudut Derajat:</span>
        <div class="flex items-center gap-1 font-mono font-bold text-(--foreground)">
          <button type="button" id="btn-canvas-angle-minus-5" class="px-1.5 py-0.5 rounded bg-(--muted) hover:bg-(--border) text-[10px] font-bold cursor-pointer" title="Kurangi 5°">-5°</button>
          <button type="button" id="btn-canvas-angle-minus-1" class="px-1.5 py-0.5 rounded bg-(--muted) hover:bg-(--border) text-[10px] font-bold cursor-pointer" title="Kurangi 1°">-1°</button>
          <span id="canvas-angle-slider-label" class="text-xs px-1 text-indigo-600 dark:text-cyan-300">45.0°</span>
          <button type="button" id="btn-canvas-angle-plus-1" class="px-1.5 py-0.5 rounded bg-(--muted) hover:bg-(--border) text-[10px] font-bold cursor-pointer" title="Tambah 1°">+1°</button>
          <button type="button" id="btn-canvas-angle-plus-5" class="px-1.5 py-0.5 rounded bg-(--muted) hover:bg-(--border) text-[10px] font-bold cursor-pointer" title="Tambah 5°">+5°</button>
        </div>
      </div>
      <input
        type="range"
        id="slider-angle-degree"
        min="0"
        max="360"
        step="0.5"
        value="45"
        class="w-full h-2 rounded-lg bg-(--muted) appearance-none cursor-pointer accent-indigo-600 dark:accent-cyan-400"
        aria-label="Slider besar sudut derajat"
      />
    </div>
  </div>

  <!-- Bottom Ruler Footer Legend -->
  <div class="px-4 py-2 bg-(--card) border-t border-(--border) flex flex-wrap items-center justify-between gap-2 text-[11px] text-(--muted-foreground)">
    <div class="flex items-center gap-4">
      <span id="legend-item-1" class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
        <span id="legend-text-1">Sisi Atas / Sumbu X: <strong>Sentimeter (cm) & Milimeter (mm)</strong></span>
      </span>
      <span id="scale-legend-bottom" class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
        <span id="legend-text-2">Sisi Bawah / Sumbu Y: <strong>Inci (inch, 1/16")</strong></span>
      </span>
    </div>
    <div class="hidden sm:block">
      <span id="legend-hint">Tekan tombol <strong>"Kunci Layar (Sentuh)"</strong> untuk membekukan posisi saat mengukur benda fisik</span>
    </div>
  </div>
</div>
